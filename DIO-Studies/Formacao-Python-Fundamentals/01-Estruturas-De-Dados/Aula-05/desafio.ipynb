   "source": [
    "def soma_tupla(tupla):\n",
    "    return sum(tupla)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    entrada = input()\n",
    "    elementos = tuple(map(int, entrada.split()))\n",
    "    \n",
    "    resultado = soma_tupla(elementos)\n",
    "    print(f\"A soma dos elementos da tupla é: {resultado}\")"
   ]
  }
